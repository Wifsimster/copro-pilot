# ============================================
# CoproPilot Backend — Variables d'environnement
# ============================================

# Environnement (development | production)
NODE_ENV=development

# Port du serveur
PORT=3001

# ============================================
# Base de données PostgreSQL
# ============================================
# Option 1 : URI complète
# POSTGRES_URI=postgresql://copro_pilot:password@localhost:5432/copro_pilot

# Option 2 : Variables séparées
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=copro_pilot
POSTGRES_USER=copro_pilot
POSTGRES_PASSWORD=password

# ============================================
# Authentification Better Auth
# ============================================
BETTER_AUTH_SECRET=your-secret-key-change-me-in-production

# ============================================
# Frontend URL (pour CORS et Better Auth)
# ============================================
BASE_URL=http://localhost:3000

# ============================================
# Email (production uniquement)
# ============================================
# En développement, les emails sont affichés dans la console.
#
# Deux providers sont supportés, essayés dans cet ordre :
#   1. Resend (recommandé)   — définir RESEND_API_KEY
#   2. SMTP (nodemailer)     — définir SMTP_HOST et les variables SMTP_*
# Si aucun provider n'est configuré en production, les emails sont loggués.

# --- Resend (https://resend.com) ---
RESEND_API_KEY=
# Expéditeur utilisé par Resend (doit être un domaine vérifié chez Resend)
RESEND_FROM="CoproPilot <noreply@copropilot.fr>"

# --- SMTP (fallback) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@copropilot.fr

# ============================================
# Stripe (paiements et abonnements)
# ============================================
# Clés API (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook signing secret (stripe listen --print-secret)
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs des abonnements (mensuel + annuel pour chaque plan)
STRIPE_PRICE_ESSENTIEL_MONTHLY=price_...
STRIPE_PRICE_ESSENTIEL_YEARLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_ENTREPRISE_MONTHLY=price_...
STRIPE_PRICE_ENTREPRISE_YEARLY=price_...

# Price IDs des dépassements (metered billing)
STRIPE_PRICE_PRO_EXTRA_COPRO=price_...
STRIPE_PRICE_PRO_EXTRA_USER=price_...
STRIPE_PRICE_ENTREPRISE_EXTRA_COPRO=price_...
STRIPE_PRICE_ENTREPRISE_EXTRA_USER=price_...

# Mode de licence (cloud = quotas enforced, self-hosted = no limits)
LICENSING_MODE=cloud

# ============================================
# PII Encryption (optional)
# ============================================
# Optional: PII encryption key (64 hex chars = 32 bytes)
# Generate with: node scripts/generate-encryption-key.js
# When set, sensitive fields (IBAN) are encrypted at rest using AES-256-GCM
PII_ENCRYPTION_KEY=
