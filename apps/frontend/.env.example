# Backend API URL (defaults to /api if not set, proxied by Vite in dev)
VITE_BACKEND_URL=/api

# Koe support widget — bug reports, feature requests & live chat
# Leave VITE_KOE_PROJECT_KEY empty to disable the widget entirely.
# See https://github.com/Wifsimster/koe for self-hosting the Koe service.
VITE_KOE_PROJECT_KEY=
VITE_KOE_API_URL=https://api.koe.dev
